{
  "name": "panner",
  "version": "0.1.0",
  "private": true,
  "description": "Find Godot proposals the engine won't build that authors say could be add-ons.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "tsx pipeline/sync.ts",
    "build:data": "tsx pipeline/build-data.ts",
    "label": "tsx pipeline/label.ts",
    "eval": "tsx pipeline/eval.ts",
    "dev": "npm run build:data && vite",
    "build": "npm run build:data && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
